{
  "manifest_version": 3,
  "name": "Responsive DevTool",
  "version": "2.5.0",
  "description": "Preview any site on dozens of devices at once, inspect CSS & layout, test breakpoints and take screenshots.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Responsive DevTool",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{123e868f-9db7-4299-b7ce-e08c823719bf}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "author": "zuhoor12",
  "homepage_url": "https://github.com/zuhoor12"
}