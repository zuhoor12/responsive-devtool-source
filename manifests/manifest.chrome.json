{
  "manifest_version": 3,
  "name": "Responsive DevTool",
  "version": "2.5.0",
  "description": "Preview any site on dozens of devices at once, inspect CSS & layout, test breakpoints, throttle the network and take screenshots.",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Responsive DevTool",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "author": "zuhoor12",
  "homepage_url": "https://github.com/zuhoor12"
}